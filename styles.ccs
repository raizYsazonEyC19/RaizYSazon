/* ===========================
   RAÍZ Y SAZÓN
   Estilos principales
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#F8F4EC;
    color:#4A4035;
    line-height:1.6;
}

/* HERO */

.hero{
    background:linear-gradient(rgba(248,244,236,.92),rgba(248,244,236,.92)),
    url("https://images.unsplash.com/photo-1509358271058-acd22cc93898?auto=format&fit=crop&w=1400&q=80");
    background-size:cover;
    background-position:center;
    min-height:90vh;

    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;

    padding:40px 20px;
}

.overlay{
    max-width:700px;
}

.logo{
    width:140px;
    margin-bottom:25px;
}

.hero h1{
    font-size:58px;
    color:#6D5336;
}

.subtitulo{
    margin-top:10px;
    letter-spacing:3px;
    color:#8A7357;
}

.frase{
    margin-top:25px;
    font-size:22px;
    font-style:italic;
}

/* BOTÓN */

.boton{

display:inline-block;

margin-top:35px;

padding:16px 34px;

background:#7C5B3B;

color:white;

text-decoration:none;

border-radius:40px;

transition:.3s;

}

.boton:hover{

background:#5C4128;

transform:translateY(-3px);

}

/* SECCIONES */

section{

padding:70px 8%;

}

section h2{

font-size:38px;

margin-bottom:20px;

text-align:center;

color:#6D5336;

}

/* CATEGORÍAS */

.categorias{

display:flex;

flex-wrap:wrap;

justify-content:center;

gap:15px;

margin:40px 0;

}

.categorias button{

background:white;

border:none;

padding:14px 22px;

border-radius:40px;

font-size:16px;

cursor:pointer;

box-shadow:0 5px 15px rgba(0,0,0,.08);

transition:.3s;

}

.categorias button:hover{

background:#7C5B3B;

color:white;

}

/* PRODUCTOS */

#productos{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

gap:25px;

}

/* WHATSAPP */

.pedido{

background:#EFE4D0;

text-align:center;

}

.whatsapp{

display:inline-block;

margin-top:25px;

padding:16px 35px;

background:#25D366;

color:white;

text-decoration:none;

border-radius:40px;

font-weight:bold;

}

/* FOOTER */

footer{

background:#E5D7BF;

padding:35px;

text-align:center;

color:#6D5336;

}

/* CELULAR */

@media(max-width:700px){

.hero h1{

font-size:42px;

}

.logo{

width:100px;

}

section h2{

font-size:30px;
.card{

background:white;

border-radius:18px;

overflow:hidden;

box-shadow:0 10px 25px rgba(0,0,0,.08);

padding:18px;

transition:.3s;

}

.card:hover{

transform:translateY(-8px);

}

.card img{

width:100%;

height:220px;

object-fit:cover;

border-radius:12px;

}

.card h3{

margin-top:15px;

color:#6D5336;

}

.card p{

margin:10px 0;

color:#777;

}

.card button{

width:100%;

padding:12px;

background:#7C5B3B;

border:none;

border-radius:30px;

color:white;

cursor:pointer;

margin-top:10px;

font-size:15px;

}
}

}
