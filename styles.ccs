/* ===========================
   RAÍZ Y SAZÓN v3.0
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#F8F4EC;
    color:#4A3A2A;
}

/* HERO */

.hero{

    background:linear-gradient(180deg,#F7F2E8,#EFE3CF);

    min-height:70vh;

    display:flex;

    justify-content:center;

    align-items:center;

    text-align:center;

    padding:80px 20px;

}

.hero-contenido{

    max-width:800px;

}

.logo{

    font-size:90px;

    margin-bottom:20px;

}

.hero h1{

    font-size:64px;

    color:#503D2C;

}

.subtitulo{

    margin-top:15px;

    letter-spacing:3px;

    color:#8B7355;

    font-weight:bold;

}

.frase{

    margin-top:25px;

    font-size:24px;

    font-style:italic;

}

.boton{

    display:inline-block;

    margin-top:40px;

    background:#755235;

    color:white;

    padding:18px 45px;

    text-decoration:none;

    border-radius:50px;

    transition:.3s;

}

.boton:hover{

    background:#5A3E28;

}

/* BUSCADOR */

.busqueda{

    width:90%;

    max-width:700px;

    margin:auto;

    margin-top:-30px;

}

#buscar{

    width:100%;

    padding:18px;

    border:none;

    border-radius:50px;

    font-size:18px;

    box-shadow:0 8px 20px rgba(0,0,0,.10);

    outline:none;

}

/* TÍTULOS */

section{

    padding:70px 8%;

}

section h2{

    text-align:center;

    margin-bottom:35px;

    color:#5E4731;

    font-size:42px;

}

/* PRODUCTOS */

#productos{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:30px;

}

/* TARJETAS */

.card{

    background:white;

    border-radius:20px;

    overflow:hidden;

    box-shadow:0 10px 25px rgba(0,0,0,.08);

    transition:.3s;

}

.card:hover{

    transform:translateY(-8px);

}

.card img{

    width:100%;

    height:220px;

    object-fit:cover;

}

.card h3{

    padding:15px;

    color:#4A3A2A;

}

.card p{

    padding:0 15px;

    color:#777;

}

.card strong{

    display:block;

    padding:15px;

    color:#755235;

}

.card button{

    width:calc(100% - 30px);

    margin:15px;

    padding:14px;

    border:none;

    border-radius:40px;

    background:#755235;

    color:white;

    cursor:pointer;

    transition:.3s;

}

.card button:hover{

    background:#5A3E28;

}

/* CONTACTO */

.contacto{

    background:#EFE3CF;

    text-align:center;

}

.contacto a{

    display:inline-block;

    margin-top:25px;

    background:#25D366;

    color:white;

    padding:18px 35px;

    text-decoration:none;

    border-radius:40px;

    font-weight:bold;

}

/* FOOTER */

footer{

    background:#E3D2B7;

    text-align:center;

    padding:35px;

}

/* CELULAR */

@media(max-width:768px){

.hero{

padding:60px 20px;

}

.hero h1{

font-size:42px;

}

.logo{

font-size:60px;

}

.frase{

font-size:18px;

}

section h2{

font-size:32px;

}

}
