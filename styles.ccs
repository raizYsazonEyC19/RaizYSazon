/* ===================================
   RAÍZ Y SAZÓN
   VERSIÓN 2.0
=================================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{

background:#F8F4EC;

color:#3D3226;

}

.hero{

min-height:70vh;

display:flex;

justify-content:center;

align-items:center;

text-align:center;

padding:60px 20px;

background:linear-gradient(#f8f4ec,#efe3cf);

}

.logo{

width:220px;

margin-bottom:25px;

}

.hero h1{

font-size:62px;

font-weight:700;

margin-bottom:15px;

color:#4D3B2B;

}

.subtitulo{

letter-spacing:4px;

font-size:18px;

color:#8B6B4A;

margin-bottom:20px;

}

.frase{

font-size:24px;

font-style:italic;

margin-bottom:35px;

}

.boton{

display:inline-block;

padding:18px 45px;

background:#7A5636;

color:white;

text-decoration:none;

border-radius:50px;

font-size:18px;

transition:.35s;

}

.boton:hover{

background:#5C4128;

transform:translateY(-3px);

}

.buscador{

width:90%;

max-width:700px;

margin:auto;

margin-top:-35px;

position:relative;

z-index:10;

}

#buscar{

width:100%;

padding:18px;

border:none;

border-radius:50px;

font-size:18px;

box-shadow:0 10px 25px rgba(0,0,0,.1);

outline:none;

}

section{

padding:60px 8%;

}

section h2{

text-align:center;

font-size:38px;

margin-bottom:40px;

color:#5A432D;

}

#productos{

display:grid;

grid-template-columns:repeat(auto-fill,minmax(260px,1fr));

gap:30px;

}

.card{

background:white;

border-radius:18px;

overflow:hidden;

box-shadow:0 8px 25px rgba(0,0,0,.08);

transition:.3s;

}

.card:hover{

transform:translateY(-8px);

}

.card img{

width:100%;

height:220px;

object-fit:cover;

}

.card h3{

padding:15px;

font-size:22px;

}

.card p{

padding:0 15px;

color:#777;

}

.card button{

margin:15px;

width:calc(100% - 30px);

padding:14px;

border:none;

border-radius:40px;

background:#7A5636;

color:white;

font-size:16px;

cursor:pointer;

}

.contacto{

text-align:center;

background:#EFE3CF;

}

.contacto a{

display:inline-block;

margin-top:25px;

background:#25D366;

color:white;

padding:16px 35px;

text-decoration:none;

border-radius:40px;

font-weight:bold;

}

footer{

background:#E6D5BB;

padding:30px;

text-align:center;

color:#5A432D;

}

@media(max-width:768px){

.hero h1{

font-size:42px;

}

.logo{

width:160px;

}

}
